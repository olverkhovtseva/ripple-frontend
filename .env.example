# Обязательно на проде — полный URL сайта для ссылок в письмах
NEXT_PUBLIC_APP_URL=https://privestories.ru

# SQLite по умолчанию — файл fe/dev.db
DATABASE_URL=file:./dev.db

# Отправка magic-link на реальную почту через Resend (https://resend.com)
# Без ключа ссылка выводится в консоль сервера и на странице /auth/check-email
RESEND_API_KEY=re_xxxxxxxx

# От кого приходит письмо (домен должен быть верифицирован в Resend)
AUTH_FROM_EMAIL=Prive Stories <onboarding@resend.dev>
