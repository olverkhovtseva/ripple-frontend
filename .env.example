# Обязательно на проде — полный URL сайта для ссылок в письмах
NEXT_PUBLIC_APP_URL=https://privestories.ru

# SQLite по умолчанию — файл fe/dev.db
DATABASE_URL=file:./dev.db

# Отправка писем: Unisender Go (основной) или Resend
UNISENDER_GO_API_KEY=
# Если аккаунт на go2, замените:
# UNISENDER_GO_API_URL=https://go2.unisender.ru/ru/transactional/api/v1/email/send.json
RESEND_API_KEY=

# От кого приходит письмо (домен должен быть подтверждён в Unisender)
AUTH_FROM_EMAIL=Prive Stories <hello@privestories.ru>
